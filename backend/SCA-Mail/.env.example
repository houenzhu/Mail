# Copy these values into the process environment before starting the services.
# Do not commit a populated .env file or real credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me

REDIS_HOST=192.168.198.133
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=change-me

NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# Must be the same for the gateway, mall-auth, mall-admin and all services.
INTERNAL_TOKEN=replace-with-a-random-32-byte-value
# Keep this aligned with sql/07_seed_user_auth.sql when using the demo seed.
PHONE_SALT=mall-dev-phone-salt

PAY_CHANNEL_CODE=MOCK
PAY_CHANNEL_SECRET=replace-with-a-development-secret
PAY_CHANNEL_NOTIFY_URL=http://127.0.0.1:10000/api/pay/callback/MOCK

ROCKETMQ_NAME_SERVER=127.0.0.1:9876
