# Copy these values into the process environment before starting the services.
# Do not commit a populated .env file or real credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me

REDIS_HOST=192.168.198.133
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=change-me

NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# Must be the same for the gateway, mall-auth, mall-admin and all services.
INTERNAL_TOKEN=replace-with-a-random-32-byte-value
# Keep this aligned with sql/07_seed_user_auth.sql when using the demo seed.
PHONE_SALT=mall-dev-phone-salt

PAY_CHANNEL_CODE=MOCK
PAY_CHANNEL_SECRET=replace-with-a-development-secret
PAY_CHANNEL_NOTIFY_URL=http://127.0.0.1:10000/api/pay/callback/MOCK

ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# Product image upload (mall-admin). Credentials are read from the process environment.
# Set these in your OS user environment or IDE run configuration; never commit real keys.
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=zheliving-10000
OSS_PUBLIC_READ=true
OSS_URL_EXPIRE_SECONDS=86400
OSS_MAX_FILE_SIZE=5242880
# Aliyun RAM user AccessKey. Keep these names exactly; OssUploadService reads them directly.
AccessKeyID=replace-with-your-access-key-id
AccessKeySecret=replace-with-your-access-key-secret
